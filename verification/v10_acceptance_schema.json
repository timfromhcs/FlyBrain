{
  "schema_version": "v10_acceptance_v1",
  "project": "timfromhcs/FlyBrain",
  "target_version": "10.0.0",
  "description": "V10 Canonical Acceptance Matrix Schema with 56 Required Minimum Acceptance Gates.",
  "failure_policy": {
    "FAIL": "A required gate check failed -> release strictly blocked.",
    "SKIP_ENVIRONMENT": "Allowed strictly when the runtime environment genuinely lacks hardware/model capability (e.g. Vulkan device absent on headless CPU CI, or GGUF weights not downloaded). Reason must explicitly detail missing capability.",
    "ERROR": "Ambiguous, unhandled or non-reproducible error -> fail-closed (treated as FAIL)."
  },
