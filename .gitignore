.venv/
__pycache__/
*.pyc
.pytest_cache/
*.tmp
backups/
# Local model binaries (acquired via scripts/acquire_models.py, never committed)
models/
# ...but the model *code* (registry/manager/adapters) is tracked:
!src/models/
diagnostics/connectome_cache/
diagnostics/snapshots/
*.db
*.db-journal
*.npz
*.log
# Local model weights are provided separately; never commit binaries.
llm/gguf/*.gguf
# Test-run artifacts (regenerated on every suite run, never committed)
diagnostics/test_*
diagnostics/*reverify*
diagnostics/e2e_test_snap*
diagnostics/runtime_cont_*
diagnostics/alife_experiments_reverify_tmp/
visual_evidence/images/gen_*.png
visual_evidence/imagined/
visual_evidence/audio/speech_*.wav

# Research memory is runtime state (regenerated, hash-chained)
diagnostics/research_memory.jsonl

# Build release zip archives (generated by scripts/package_release.py)
dist/*.zip

# World runtime state (regenerated chunk deltas, never committed)
data/world_chunks/
diagnostics/world_memory.db

# Python build artifacts
flybrain.egg-info/

